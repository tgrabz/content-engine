# ── Required ──────────────────────────────────────────────
# Generate a random secret: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Instagram App credentials (from Meta Developer portal)
IG_APP_ID=
IG_APP_SECRET=

# Where Instagram redirects after OAuth (must match Meta app settings)
# Local dev: https://localhost:5173/auth/callback
# Production: https://your-domain.com/auth/callback
IG_REDIRECT_URI=https://localhost:5173/auth/callback

# Public URL where Instagram can download your videos
# Local dev: use ngrok (ngrok http 8000), then paste the URL here
# Production: https://your-domain.com
PUBLIC_URL=

# ── Optional ─────────────────────────────────────────────
# AI caption generation (leave blank to disable)
ANTHROPIC_API_KEY=

# CORS origins (comma-separated). Defaults to localhost:5173
# CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# Server port (default: 8000)
# PORT=8000
